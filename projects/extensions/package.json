{
  "name": "@ng-matero/extensions",
  "version": "21.0.0-beta.2",
  "description": "Fork personalizzato di NG-Matero compatibile con Angular 21",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "author": "nzbin <nzb329@163.com> (modificato da Francesco Saverio)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fsaverioborriello/ng-matero-21.git"
  },
  "keywords": [
    "angular",
    "angular-material",
    "angular-components",
    "angular-material-extensions",
    "ng-matero",
    "data-grid",
    "ngx-data-grid",
    "material-data-table",
    "color-picker",
    "ngx-color",
    "ngx-color-picker",
    "ng-select",
    "typeahead",
    "autocomplete",
    "checkbox-group",
    "popover",
    "datetimepicker"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fsaverioborriello/ng-matero-21/issues"
  },
  "homepage": "https://github.com/fsaverioborriello/ng-matero-21",
  "exports": {
    ".": {
      "sass": "./_index.scss"
    },
    "./prebuilt-themes/*": {
      "style": "./prebuilt-themes/*.css"
    }
  },
  "dependencies": {
    "@ng-select/ng-select": "^20.0.0",
    "ngx-color": "^10.0.0",
    "photoviewer": "^3.10.0",
    "tslib": "^2.4.0"
  },
  "peerDependencies": {
    "@angular/cdk": ">=21.0.0",
    "@angular/common": ">=21.0.0",
    "@angular/core": ">=21.0.0",
    "@angular/material": ">=21.0.0"
  },
  "sideEffects": false
}
